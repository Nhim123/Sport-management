# Cấu hình kết nối backend cho app mobile (Expo).
# Sao chép thành .env rồi chỉnh giá trị. Biến phải có tiền tố EXPO_PUBLIC_ để lộ ra client.

# Địa chỉ gốc của REST API (backend)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Dùng dữ liệu mẫu (true) hay gọi API thật (false). Để trống/true khi chưa dựng backend.
EXPO_PUBLIC_USE_MOCK=true
