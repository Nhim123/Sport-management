# Cấu hình backend. Sao chép thành .env rồi chỉnh.

# Cổng chạy API
PORT=4000

# Chuỗi kết nối PostgreSQL.
# Máy dev: chạy `npm run db:up` (Postgres trong Docker, khớp chuỗi dưới đây).
# Production (Neon…): dán chuỗi kết nối của nhà cung cấp, thường có ?sslmode=require
DATABASE_URL="postgresql://arena:arena@localhost:5432/arena"

# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy). * = cho phép tất cả (chỉ dùng khi dev).
# Production: CORS_ORIGIN=https://admin.<tên-miền>
CORS_ORIGIN=*
