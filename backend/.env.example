# Cấu hình backend. Sao chép thành .env rồi chỉnh.

# Cổng chạy API
PORT=4000

# Chuỗi kết nối DB. Mặc định SQLite (chạy ngay, không cần cài đặt gì).
# Đổi sang PostgreSQL: DATABASE_URL="postgresql://user:pass@localhost:5432/arena"
# (và đổi provider trong prisma/schema.prisma thành "postgresql")
DATABASE_URL="file:./dev.db"

# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy). * = cho phép tất cả (chỉ dùng khi dev).
CORS_ORIGIN=*
