# Cấu hình backend. Sao chép thành .env rồi chỉnh.

# Cổng chạy API
PORT=4000

# Chuỗi kết nối PostgreSQL – cần cả hai biến.
# Máy dev: chạy `npm run db:up` (Postgres trong Docker), để hai chuỗi giống nhau như dưới đây.
# Production (Supabase → Project → Connect → ORM / Prisma):
#   DATABASE_URL = Transaction pooler (cổng 6543), thêm ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = Session pooler (cổng 5432) – dùng cho prisma migrate
#   VD: postgresql://postgres.<project-ref>:<mật-khẩu>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://arena:arena@localhost:5432/arena"
DIRECT_URL="postgresql://arena:arena@localhost:5432/arena"

# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy). * = cho phép tất cả (chỉ dùng khi dev).
# Production: CORS_ORIGIN=https://admin.<tên-miền>
CORS_ORIGIN=*
